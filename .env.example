# Pulsus Quality — environment. Copy to .env.local for local development.

# ── Database (required on a hosted deployment) ───────────────────────────────
# Neon Postgres, attached through the hosting integration. Migrations run on
# first use (and from Settings → About for admins). Locally, with these unset,
# the app uses PGlite under .data/pglite (no install needed).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Files: evidence and photos (and the previous version's data, read once) ──
# Injected when a Vercel Blob store is connected. Locally: .data/blob.
BLOB_READ_WRITE_TOKEN=

# ── Pulsus Platform ─────────────────────────────────────────────────────────
# Sessions are the platform's (exec_auth, RS256 via its JWKS). Defaults:
# https://executive.pulsus.tech (demo: https://demo-executive.pulsus.tech).
# PLATFORM_URL=
# PLATFORM_JWKS_URL=
# The institution's machine feed on /api/data (Command Center synthesis), optional:
# PULSE_FEED_TOKEN=

# ── The institution's own people (tenant "_own") ────────────────────────────
# The allow-list: the institution's domain and named administrators live in
# institution/index.ts. Extra admins / supervisors, comma separated:
# ADMIN_EMAILS=
# SUPERVISOR_EMAILS=
# ALLOWED_EMAIL_DOMAIN=
# Licence wall for the institution's tenant: on | off | unset (from LICENSE_WALL_AT)
# LICENSE_WALL=

# ── Pulsus Risk (docs/risk-contract.md) ─────────────────────────────────────
# Unset: proposals are stored in the outbox and not sent.
# RISK_INTAKE_URL=
# RISK_INTAKE_KEY=

# ── Demo deployment only ────────────────────────────────────────────────────
# DEMO_MODE=1 opens straight into fictional Meridian Financial Group data (its own database).
# DEMO_MODE=
