# ─────────────────────────────────────────────────────────────────────────────
# Pulsus Quality (Branch Defects & Operational Standard) — environment configuration
# Copy to .env.local for local dev; set these in Vercel for deploys.
# ─────────────────────────────────────────────────────────────────────────────

# Secret used to sign the admin session cookie (any long random string).
# REQUIRED in production: without it the app refuses to serve or sign anyone in.
# (Local dev only falls back to an insecure throwaway.) Generate: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Sign-in passwords. There are NO built-in defaults: a role with neither an in-app
# password nor its variable here cannot sign in ("Ask your administrator to set a
# password"). Once a password is changed in-app (Settings), its scrypt hash is
# persisted to storage and takes precedence over the variable.
ADMIN_PASSWORD=
# Shared Supervisor and Officer (inspector) role passwords.
SUPERVISOR_PASSWORD=
OFFICER_PASSWORD=

# Named administrators — the people who unlock admin by continuing as THEMSELVES
# (the sign-in offers "Continue as <name>"), no shared password. The roster lives
# in institution/index.ts, in the repo rather than here because it is shared word for
# word with the sibling Pulsus apps so the same people are administrators
# everywhere. This env var is an optional extra list, unioned with that file.
# ADMIN_EMAILS=

# ── Vercel Blob storage ──────────────────────────────────────────────────────
# BLOB_READ_WRITE_TOKEN is injected automatically when you connect a Vercel Blob
# store to the project. With no token set, the app uses a local ./.data folder
# (dev only) so `next dev` works without cloud storage.
BLOB_READ_WRITE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Microsoft Entra ID (Azure AD) — "Sign in with Microsoft" (ADDITIVE, identity
# only). People sign in as themselves and are mapped to a role from their
# verified email. INERT UNTIL CONFIGURED: with the two AZURE_AD_* values unset,
# the Microsoft button is hidden and role/admin sign-in is exactly as before.
# SSO NEVER grants admin — admin stays behind the admin password.
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=
# AZURE_AD_TENANT_ID=common
# (SESSION_SECRET signs the session cookie for both SSO and the role/admin login.)
#
# Role mapping:
#   SUPERVISOR_EMAILS    -> supervisor. Defaults to the institution's
#                           supervisor (institution/index.ts) if unset. Comma-separated.
#   ALLOWED_EMAIL_DOMAIN -> any other account on this domain signs in as an
#                           inspector/officer (default: institution/index.ts; "none" off).
#   INSPECTOR_EMAILS     -> optional explicit inspector allowlist. Comma-separated.
# SUPERVISOR_EMAILS=
# ALLOWED_EMAIL_DOMAIN=example.com
#
# Azure redirect URI to register: https://<your-host>/api/auth/microsoft/callback
